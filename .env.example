# ------------------------------------------------------------------------------
# Sentinel Fraud Engine - environment template
# Copy to `.env` for local development. Never commit the populated file.
# ------------------------------------------------------------------------------

# Runtime identity
ENVIRONMENT=development
DEMO_MODE=true

# Ingestion: simulator | kafka | off
INGEST_MODE=simulator
INGEST_FALLBACK=simulator
SIMULATOR_TPS=0.2
SIMULATOR_SEED=0

# Kafka (used when INGEST_MODE=kafka)
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC=transaksi-finansial
KAFKA_GROUP=sentinel-scoring-v1

# Storage
# SQLite is the zero-config default. For Postgres use, for example:
# DATABASE_URL=postgresql+psycopg://sentinel:secret@db:5432/sentinel
DATABASE_URL=sqlite:///data/sentinel.db
SEED_DEMO_DATA=true
RESET_ON_START=false
RETENTION_DAYS=7

# Model artifact directory. The repository ships a trained model.
MODEL_DIR=artifacts
MODEL_VERSION=iforest-2026.02

# Write authentication. If set, POST/PATCH endpoints require X-API-Key.
# GET endpoints and the console remain public in demo mode.
SENTINEL_API_KEY=

# Alert delivery
TELEGRAM_TOKEN=
CHAT_ID=
ALERT_WEBHOOK_URL=
PUBLIC_BASE_URL=

# Browser / proxy
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
MAX_LIVE_BUFFER=500
STREAM_QUEUE_SIZE=256

# Frontend development proxy (only read by Vite; never exposed in the bundle).
VITE_API_PROXY=http://127.0.0.1:8000

